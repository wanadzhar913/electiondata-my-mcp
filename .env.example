# Streamable HTTP (ignored on stdio)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
MCP_ENABLE_DNS_REBINDING_PROTECTION=true

# DuckDB cursor pool (stdio and HTTP; one database per process)
MCP_DUCKDB_POOL_SIZE=4
MCP_DUCKDB_POOL_TIMEOUT=10

# OAuth 2.1 resource server (Streamable HTTP only). Leave unset and /mcp stays
# open, which is the public-lake default. Stdio never checks these.
# Tokens come from your authorization server; this process only verifies them.
# MCP_OAUTH_ISSUER_URL=https://auth.example.com/realms/electiondata
# MCP_OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=electiondata:read
# JWT access tokens, verified against the authorization server's JWKS:
# MCP_OAUTH_JWKS_URL=https://auth.example.com/realms/electiondata/protocol/openid-connect/certs
# Only when tokens carry an aud other than MCP_OAUTH_RESOURCE_URL:
# MCP_OAUTH_AUDIENCE=api://electiondata
